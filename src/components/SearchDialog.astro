---
import SearchInterface from "./SearchInterface.astro";
---

<dialog class="search-dialog glass" data-search-dialog aria-labelledby="search-dialog-title">
  <div class="search-dialog-heading">
    <div>
      <p class="eyebrow">Search</p>
      <h2 id="search-dialog-title">搜索笔记</h2>
    </div>
    <button type="button" class="search-close" data-search-close aria-label="关闭搜索">×</button>
  </div>
  <SearchInterface />
</dialog>

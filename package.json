{
  "name": "aurora-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "preview:local": "astro preview",
    "build": "astro build && node scripts/build-search.mjs",
    "preview": "astro preview",
    "sync:check": "node scripts/sync-content.ts --check",
    "sync": "node scripts/sync-content.ts",
    "release:prepare": "node scripts/prepare-release.ts",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "npm run typecheck && npm test && npm run build",
    "verify:built": "node scripts/verify-built-site.mjs"
  },
  "dependencies": {
    "astro": "7.3.6",
    "github-slugger": "2.0.0",
    "hast-util-to-text": "4.0.2",
    "mdast-util-to-string": "4.0.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/sanitize-html": "2.16.2",
    "@types/three": "0.186.0",
    "pagefind": "1.5.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
